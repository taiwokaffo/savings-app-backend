# App
PORT=3000
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=savings_app
DB_SYNCHRONIZE=true

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# Mail (SMTP) - leave blank to just log verification emails to the console.
# To visually inspect emails instead, run `docker compose up mailhog` and
# point at it: MAIL_HOST=localhost, MAIL_PORT=1025, then open
# http://localhost:8025 in your browser. No auth needed for MailHog.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Savings App <no-reply@savings-app.local>

# Payments — Paystack (wallet funding via real payment API)
# Required to use POST /wallet/fund/paystack/initialize and the webhook.
# Without it, those endpoints return 503 rather than silently doing nothing.
# Get test keys from https://dashboard.paystack.com -> Settings -> API Keys.
PAYSTACK_SECRET_KEY=

# Identity verification — Korapay (NIN/BVN checks on profile update)
# Required to submit `nin` or `bvn` via PATCH /users/me/profile.
# Get test keys from https://dashboard.korapay.com -> Settings -> API Keys.
KORAPAY_SECRET_KEY=
